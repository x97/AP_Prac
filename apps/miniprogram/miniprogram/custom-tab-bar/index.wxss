.tab-bar {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 1000;
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
  border-top: 1rpx solid #e6e2d9;
  background: #fffdfa;
  box-shadow: 0 -10rpx 30rpx rgba(28, 31, 36, 0.06);
}

.tab-bar-inner {
  display: flex;
  height: 120rpx;
}

.tab-item {
  position: relative;
  display: flex;
  flex: 1;
  align-items: center;
  justify-content: center;
  color: #6b7280;
  font-size: 32rpx;
  font-weight: 500;
  letter-spacing: 0.06em;
}

.tab-item.is-active {
  color: #2f5be8;
  font-weight: 700;
}

.tab-text {
  line-height: 1;
}

.tab-indicator {
  position: absolute;
  bottom: 18rpx;
  left: 50%;
  width: 40rpx;
  height: 6rpx;
  margin-left: -20rpx;
  border-radius: 999rpx;
  background: transparent;
}

.tab-item.is-active .tab-indicator {
  background: #2f5be8;
}
