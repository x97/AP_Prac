.study-page {
  min-height: 100vh;
  padding: 32rpx 32rpx calc(36rpx + env(safe-area-inset-bottom));
  background: var(--bg);
}

.study-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.study-count {
  color: var(--muted);
  font-family: "SFMono-Regular", Menlo, monospace;
  font-size: 22rpx;
  font-variant-numeric: tabular-nums;
}

.study-offline {
  display: flex;
  gap: 14rpx;
  margin-bottom: 20rpx;
  padding: 18rpx 22rpx;
  border: 1rpx solid var(--line);
  border-radius: 18rpx;
  background: var(--surface);
  color: var(--muted);
  font-size: 22rpx;
  line-height: 1.5;
}

.study-offline .offline-dot {
  flex: 0 0 auto;
  width: 10rpx;
  height: 10rpx;
  margin-top: 11rpx;
  border-radius: 50%;
  background: var(--muted);
}

.study-error {
  margin-top: 22rpx;
  padding: 18rpx 22rpx;
  border: 1rpx solid rgba(180, 35, 24, 0.25);
  border-radius: 18rpx;
  background: rgba(180, 35, 24, 0.06);
  color: var(--danger);
  font-size: 22rpx;
  line-height: 1.5;
}

.study-loading {
  padding-top: 8rpx;
}

.study-skeleton-card {
  height: 800rpx;
  border-radius: 28rpx;
}

.study-skeleton-line {
  width: 58%;
  height: 28rpx;
  margin: 36rpx auto 0;
}

.card-stage {
  position: relative;
  margin-top: 8rpx;
}

.audio-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 0;
  background: transparent;
  color: var(--primary);
}

.audio-btn.is-playing {
  animation: audio-pulse 1s ease-in-out infinite;
}

@keyframes audio-pulse {
  0%,
  100% {
    opacity: 1;
  }
  50% {
    opacity: 0.4;
  }
}

.speaker-icon {
  position: relative;
  width: 42rpx;
  height: 38rpx;
}

.speaker-body {
  position: absolute;
  left: 0;
  top: 11rpx;
  width: 12rpx;
  height: 16rpx;
  border-radius: 2rpx;
  background: currentColor;
}

.speaker-cone {
  position: absolute;
  left: 10rpx;
  top: 3rpx;
  width: 0;
  height: 0;
  border-top: 16rpx solid transparent;
  border-right: 16rpx solid currentColor;
  border-bottom: 16rpx solid transparent;
}

.speaker-wave {
  position: absolute;
  border: 3rpx solid currentColor;
  border-top-color: transparent;
  border-bottom-color: transparent;
  border-left-color: transparent;
  border-radius: 50%;
}

.speaker-wave-1 {
  left: 25rpx;
  top: 10rpx;
  width: 11rpx;
  height: 18rpx;
}

.speaker-wave-2 {
  left: 25rpx;
  top: 3rpx;
  width: 17rpx;
  height: 31rpx;
  opacity: 0.65;
}

.flashcard {
  position: relative;
  width: 100%;
  height: 800rpx;
  perspective: 1600rpx;
}

.flashcard-inner {
  position: relative;
  width: 100%;
  height: 100%;
  transform-style: preserve-3d;
  transition: transform 480ms cubic-bezier(0.2, 0.8, 0.2, 1);
}

.flashcard.is-flipped .flashcard-inner {
  transform: rotateY(180deg);
}

.flashcard-face {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  padding: 44rpx;
  border: 1rpx solid var(--line);
  border-radius: 28rpx;
  background: var(--surface);
  backface-visibility: hidden;
  -webkit-backface-visibility: hidden;
}

.flashcard-front {
  align-items: center;
  justify-content: center;
}

.card-head {
  position: absolute;
  top: 30rpx;
  right: 30rpx;
  left: 30rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.card-origin {
  align-self: stretch;
  overflow: hidden;
  color: var(--muted);
  font-size: 20rpx;
  letter-spacing: 0.04em;
  line-height: 1.4;
  text-overflow: ellipsis;
  text-transform: uppercase;
  white-space: nowrap;
}

.card-meta {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 8rpx;
  margin-top: 8rpx;
}

.card-stars {
  display: flex;
  align-items: center;
  gap: 4rpx;
}

.card-star {
  color: rgba(107, 114, 128, 0.22);
  font-size: 24rpx;
  line-height: 1;
}

.card-star.is-on {
  color: var(--accent);
}

.card-term {
  max-width: 100%;
  font-family: "Times New Roman", "Songti SC", "STSong", Georgia, serif;
  font-size: 74rpx;
  font-weight: 600;
  letter-spacing: -0.035em;
  line-height: 1.12;
  text-align: center;
  overflow-wrap: break-word;
}

.card-ipa {
  max-width: 94%;
  margin-top: 18rpx;
  color: var(--muted);
  font-family: "Charis SIL", "Doulos SIL", "Times New Roman", serif;
  font-size: 30rpx;
  letter-spacing: 0.01em;
  line-height: 1.5;
  text-align: center;
  overflow-wrap: break-word;
}

.card-hint {
  position: absolute;
  bottom: 38rpx;
  color: var(--faint);
  font-size: 20rpx;
}

.flashcard-back {
  justify-content: flex-start;
  overflow-y: auto;
  padding: 42rpx;
  background: #fffefb;
  text-align: center;
  transform: rotateY(180deg);
}

.back-head {
  padding: 0 64rpx 22rpx;
  border-bottom: 1rpx solid var(--line);
}

.back-term {
  color: var(--muted);
  font-family: "Times New Roman", "Songti SC", "STSong", Georgia, serif;
  font-size: 30rpx;
  font-weight: 600;
}

.back-ipa {
  margin-top: 6rpx;
  color: var(--faint);
  font-family: "Charis SIL", "Doulos SIL", "Times New Roman", serif;
  font-size: 23rpx;
  line-height: 1.5;
}

.card-def {
  width: 100%;
  margin-top: 38rpx;
  font-size: 42rpx;
  font-weight: 500;
  line-height: 1.45;
  text-align: center;
}

.card-quote {
  width: 100%;
  margin-top: 30rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid var(--line);
  color: var(--muted);
  font-size: 25rpx;
  line-height: 1.7;
  text-align: left;
}

.study-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 30rpx;
}

.pending-next {
  margin-top: 30rpx;
  padding: 22rpx;
  border: 1rpx solid var(--line);
  border-radius: 20rpx;
  background: var(--surface);
}

.pending-text {
  margin-bottom: 16rpx;
  color: var(--muted);
  font-size: 23rpx;
  text-align: center;
}

.study-actions .btn {
  flex: 1;
}

.action-again {
  color: var(--danger);
}

.study-actions .action-known {
  flex: 1.2;
}

.done-wrap {
  padding-top: 18rpx;
}

.done-card {
  padding: 54rpx 38rpx 38rpx;
  text-align: center;
}

.done-mark {
  width: 88rpx;
  height: 88rpx;
  margin: 0 auto 26rpx;
  border-radius: 50%;
  background: var(--primary-soft);
  color: var(--primary);
  font-size: 42rpx;
  font-weight: 700;
  line-height: 88rpx;
}

.done-eyebrow {
  color: var(--primary);
}

.done-title {
  margin-top: 10rpx;
  font-family: "Times New Roman", "Songti SC", "STSong", Georgia, serif;
  font-size: 52rpx;
  font-weight: 600;
  letter-spacing: -0.03em;
}

.done-sub {
  margin-top: 14rpx;
  margin-bottom: 34rpx;
  color: var(--ink);
  font-size: 27rpx;
}

.done-note {
  margin-top: 10rpx;
  color: var(--faint);
  font-size: 21rpx;
  line-height: 1.5;
}

.done-back {
  margin-top: 16rpx;
}
