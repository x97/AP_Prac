<view class="login-page">
  <view class="brand-block">
    <image class="login-logo" src="/assets/brand/psyprac-logo-sm.png" mode="aspectFit" />
    <view class="login-name">PsyPrac</view>
    <view class="login-sub">AP Psychology 记忆卡片</view>
  </view>

  <view class="login-panel">
    <button
      class="btn btn-wechat login-btn"
      hover-class="btn-hover"
      bindtap="onWechatLogin"
      loading="{{loggingIn}}"
      disabled="{{loggingIn}}"
    >
      {{loggingIn ? '登录中…' : '微信一键登录'}}
    </button>

    <view class="login-divider">
      <view class="login-divider-line"></view>
      <text>或使用邮箱</text>
      <view class="login-divider-line"></view>
    </view>

    <view class="login-tabs">
      <view
        class="login-tab {{mode === 'email' ? 'login-tab-active' : ''}}"
        data-mode="email"
        bindtap="switchMode"
      >邮箱登录</view>
      <view
        class="login-tab {{mode === 'register' ? 'login-tab-active' : ''}}"
        data-mode="register"
        bindtap="switchMode"
      >注册</view>
      <view
        class="login-tab {{mode === 'reset' ? 'login-tab-active' : ''}}"
        data-mode="reset"
        bindtap="switchMode"
      >找回密码</view>
    </view>

    <view class="login-form">
      <input
        class="login-input"
        type="text"
        placeholder="邮箱"
        value="{{email}}"
        bindinput="onEmailInput"
      />

      <view wx:if="{{mode !== 'email'}}" class="login-code-row">
        <input
          class="login-input login-code-input"
          type="number"
          maxlength="6"
          placeholder="6 位验证码"
          value="{{code}}"
          bindinput="onCodeInput"
        />
        <button
          class="login-code-btn"
          bindtap="sendCode"
          disabled="{{sendingCode || countdown > 0}}"
        >
          <text wx:if="{{countdown > 0}}">{{countdown}}s</text>
          <text wx:else>发送验证码</text>
        </button>
      </view>

      <input
        class="login-input"
        password="{{true}}"
        placeholder="{{mode === 'email' ? '密码' : '设置密码（至少 8 位）'}}"
        value="{{password}}"
        bindinput="onPasswordInput"
      />

      <view wx:if="{{devCode}}" class="login-hint">测试验证码：{{devCode}}</view>
      <view wx:if="{{notice}}" class="login-notice">{{notice}}</view>
      <view wx:if="{{error}}" class="login-error">{{error}}</view>

      <button
        class="btn btn-primary login-submit"
        hover-class="btn-hover"
        bindtap="onSubmit"
        loading="{{loggingIn}}"
        disabled="{{loggingIn}}"
      >
        {{submitLabel}}
      </button>
    </view>
  </view>

  <view wx:if="{{offline}}" class="login-offline" bindtap="onOffline">
    先进入本地预览模式
  </view>

  <view class="login-foot">psyprac.com</view>
</view>
