.cards-page {
  padding-bottom: calc(176rpx + env(safe-area-inset-bottom));
  background: var(--bg);
}

.topbar {
  display: flex;
  flex-direction: column;
}

.page-title {
  margin-top: 8rpx;
  font-family: "Times New Roman", "Songti SC", "STSong", Georgia, serif;
  font-size: 56rpx;
  font-weight: 600;
  letter-spacing: -0.035em;
  line-height: 1.1;
}

.hero-card {
  position: relative;
  display: flex;
  flex-direction: column;
  min-height: 680rpx;
  margin-top: 30rpx;
  padding: 44rpx 40rpx 40rpx;
  border: 1rpx solid rgba(141, 122, 88, 0.24);
  border-radius: 32rpx;
  background:
    radial-gradient(120% 90% at 92% -12%, rgba(47, 91, 232, 0.15) 0%, rgba(47, 91, 232, 0) 58%),
    radial-gradient(95% 80% at -6% 108%, rgba(180, 83, 9, 0.13) 0%, rgba(180, 83, 9, 0) 55%),
    linear-gradient(160deg, #fffdf8 0%, #f8f2e6 52%, #efe8d9 100%);
  box-shadow:
    0 28rpx 64rpx rgba(74, 58, 32, 0.14),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.9);
}

.hero-card::before {
  content: "";
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  border-radius: 31rpx;
  background-image:
    repeating-linear-gradient(
      108deg,
      rgba(126, 110, 82, 0.05) 0,
      rgba(126, 110, 82, 0.05) 1rpx,
      transparent 1rpx,
      transparent 6rpx
    ),
    repeating-linear-gradient(
      18deg,
      rgba(255, 255, 255, 0.34) 0,
      rgba(255, 255, 255, 0.34) 1rpx,
      transparent 1rpx,
      transparent 10rpx
    );
  pointer-events: none;
}

.hero-card.is-open {
  z-index: 91;
}

.hero-watermark {
  position: absolute;
  right: 20rpx;
  bottom: 142rpx;
  z-index: 0;
  color: rgba(47, 91, 232, 0.05);
  font-family: "Times New Roman", "Songti SC", "STSong", Georgia, serif;
  font-size: 260rpx;
  font-weight: 700;
  letter-spacing: -0.08em;
  line-height: 1;
  pointer-events: none;
}

.hero-top {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.hero-label {
  flex: 0 1 auto;
  overflow: hidden;
  color: var(--faint);
  font-size: 20rpx;
  letter-spacing: 0.12em;
  text-overflow: ellipsis;
  text-transform: uppercase;
  white-space: nowrap;
}

.scope-trigger {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  gap: 6rpx;
  max-width: 52%;
  color: var(--muted);
  font-size: 22rpx;
}

.scope-value {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.scope-caret {
  flex: 0 0 auto;
  color: var(--faint);
  font-size: 18rpx;
}

.scope-panel {
  position: absolute;
  top: 92rpx;
  right: 24rpx;
  z-index: 2;
  width: 320rpx;
  padding: 8rpx 0;
  border: 1rpx solid var(--line);
  border-radius: 18rpx;
  background: var(--surface);
  box-shadow: 0 18rpx 40rpx rgba(74, 58, 32, 0.12);
}

.scope-option {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 68rpx;
  padding: 0 24rpx;
  color: var(--muted);
  font-size: 24rpx;
}

.scope-option.is-on {
  color: var(--primary);
  font-weight: 650;
}

.scope-check {
  font-size: 22rpx;
}

.scope-done {
  margin-top: 6rpx;
  padding: 18rpx 24rpx 10rpx;
  border-top: 1rpx solid var(--line);
  color: var(--primary);
  font-size: 23rpx;
  text-align: center;
}

.hero-body {
  position: relative;
  z-index: 1;
  display: flex;
  flex: 1;
  flex-direction: column;
  justify-content: center;
  margin-top: 46rpx;
}

.hero-count {
  display: flex;
  align-items: baseline;
  gap: 14rpx;
}

.hero-number {
  color: var(--ink);
  font-family: "Times New Roman", "Songti SC", "STSong", Georgia, serif;
  font-size: 132rpx;
  font-weight: 600;
  letter-spacing: -0.06em;
  line-height: 0.9;
  font-variant-numeric: tabular-nums;
}

.hero-number-loading {
  color: var(--faint);
}

.hero-unit {
  color: var(--muted);
  font-size: 28rpx;
  letter-spacing: 0.08em;
}

.hero-actions {
  position: relative;
  z-index: 1;
  margin-top: auto;
  padding-top: 48rpx;
}

.start-btn {
  min-height: 100rpx;
  border-radius: 22rpx;
  box-shadow: 0 14rpx 30rpx rgba(47, 91, 232, 0.28);
  font-size: 30rpx;
  letter-spacing: 0.08em;
}

.offline-note {
  display: flex;
  gap: 14rpx;
  margin-top: 22rpx;
  padding: 20rpx 22rpx;
  border: 1rpx solid var(--line);
  border-radius: 20rpx;
  background: var(--surface);
  color: var(--muted);
  font-size: 22rpx;
  line-height: 1.55;
}

.offline-dot {
  flex: 0 0 auto;
  width: 10rpx;
  height: 10rpx;
  margin-top: 12rpx;
  border-radius: 50%;
  background: var(--muted);
}

.scope-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 90;
}

.footer-brand {
  margin-top: 56rpx;
}
