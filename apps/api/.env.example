APP_ENV=dev
SECRET_KEY=dev-secret-change-me
CONTENT_DIR=data/releases/active
ASSET_BASE_URL=/assets
CONTENT_ENCRYPTION_MODE=optional
CONTENT_ENCRYPTION_PREFIXES=/api/v1/attempts,/api/v1/practice-sessions,/api/v1/practice-groups,/api/v1/papers,/api/v1/knowledge-graph,/api/v1/me,/api/v1/flashcards,/api/v1/question-reports
ASSET_SIGNING_REQUIRED=true
ASSET_SIGNING_KEY=
ASSET_URL_TTL_SECONDS=7200
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=600
EMAIL_PROVIDER=dev
DEV_OTP_CODE=246810
EXPOSE_DEV_OTP=true
OTP_EMAIL_PER_MINUTE=1
OTP_EMAIL_PER_HOUR=5
OTP_IP_PER_HOUR=20
PASSWORD_MIN_LENGTH=8
# Production email delivery (EMAIL_PROVIDER=smtp)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
SMTP_SSL=false
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
AUTO_CREATE_TABLES=true
SESSION_DAYS=30
WECHAT_MINI_APPID=
WECHAT_MINI_SECRET=

ADMIN_COOKIE_NAME=ap_admin_session
ADMIN_SESSION_HOURS=12
ADMIN_CONTENT_WRITE_ENABLED=false
FLASHCARD_NEW_PER_DAY=60

# Admin content materialization (Release + admin overrides)
EFFECTIVE_CONTENT_DIR=data/app/effective
