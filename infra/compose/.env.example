# Copy to infra/compose/.env and fill in secrets.
POSTGRES_PASSWORD=change-me
SECRET_KEY=change-me-to-a-long-random-string

# Production email:
# Alibaba Cloud DirectMail (transactional email):
#   SMTP_HOST=smtpdm.aliyun.com
#   SMTP_PORT=465
#   SMTP_SSL=true
#   SMTP_STARTTLS=false
# Alibaba enterprise mail:
#   SMTP_HOST=smtp.qiye.aliyun.com
#   SMTP_PORT=465
#   SMTP_SSL=true
#   SMTP_STARTTLS=false
EMAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
SMTP_SSL=false

WECHAT_MINI_APPID=
WECHAT_MINI_SECRET=

DOMAIN=psyprac.com
CORS_ORIGINS=https://www.psyprac.com,https://psyprac.com,https://manager.psyprac.com,https://miniapp.psyprac.com

# Content security
CONTENT_ENCRYPTION_MODE=required
ASSET_SIGNING_REQUIRED=true
ASSET_SIGNING_KEY=
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=600
